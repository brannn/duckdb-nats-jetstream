# name: test/sql/nats_scan.test
# description: nats_scan checks that need no NATS server (the schema is resolved before connecting)
# group: [nats_js]

require nats_js

# base columns: the payload is a BLOB unless json_extract is used
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s'));
----
stream	VARCHAR
subject	VARCHAR
seq	UBIGINT
ts_nats	TIMESTAMP
payload	BLOB

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', json_extract := ['device_id', 'kw']));
----
stream	VARCHAR
subject	VARCHAR
seq	UBIGINT
ts_nats	TIMESTAMP
payload	VARCHAR
device_id	VARCHAR
kw	VARCHAR

# protobuf columns take their types from the schema
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/types_test.proto',
    proto_message := 'TypesTest',
    proto_extract := ['str_field', 'bytes_field', 'int32_field', 'int64_field', 'uint32_field', 'uint64_field',
                      'sint32_field', 'sint64_field', 'fixed32_field', 'fixed64_field', 'sfixed32_field',
                      'sfixed64_field', 'float_field', 'double_field', 'bool_field', 'status_field']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats');
----
payload	BLOB
str_field	VARCHAR
bytes_field	BLOB
int32_field	INTEGER
int64_field	BIGINT
uint32_field	UINTEGER
uint64_field	UBIGINT
sint32_field	INTEGER
sint64_field	BIGINT
fixed32_field	UINTEGER
fixed64_field	UBIGINT
sfixed32_field	INTEGER
sfixed64_field	BIGINT
float_field	FLOAT
double_field	DOUBLE
bool_field	BOOLEAN
status_field	VARCHAR

# nested fields use dot paths and become underscored columns; repeated fields are JSON arrays
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/telemetry.proto',
    proto_message := 'Telemetry',
    proto_extract := ['device_id', 'location.zone', 'metrics.kw', 'tags']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'payload');
----
device_id	VARCHAR
location_zone	VARCHAR
metrics_kw	DOUBLE
tags	VARCHAR

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Telemetry',
    proto_extract := ['location.floor']);
----
Field 'floor' not found in message type 'Location'

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Telemetry',
    proto_extract := ['device_id.zone']);
----
Field 'device_id' is not a message type

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Nope',
    proto_extract := ['device_id']);
----
Message type 'Nope' not found

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/missing.proto', proto_message := 'M', proto_extract := ['a']);
----
Failed to import protobuf schema file

statement error
SELECT * FROM nats_scan('s', proto_extract := ['a']);
----
proto_file parameter is required when using proto_extract

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_extract := ['a']);
----
proto_message parameter is required when using proto_extract

statement error
SELECT * FROM nats_scan('s', json_extract := ['a'], proto_extract := ['b']);
----
Cannot use both json_extract and proto_extract parameters

statement error
SELECT * FROM nats_scan('s', start_seq := 1, start_time := TIMESTAMP '2026-01-01 00:00:00');
----
Cannot mix sequence-based (start_seq/end_seq) and time-based (start_time/end_time) parameters

statement error
SELECT * FROM nats_scan('s', unknown_option := 1);
----
unknown_option

# nothing listens on port 1
statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1');
----
Failed to connect to NATS

# json_extract paths become underscored columns; names that repeat a column get a suffix
query I
SELECT column_name FROM (DESCRIBE SELECT * FROM nats_scan('s', json_extract := ['location.zone', 'subject', 'Seq', 'kw', 'kw']));
----
stream
subject
seq
ts_nats
payload
location_zone
subject_1
Seq_1
kw
kw_1

# repeated and map fields are JSON (VARCHAR), as is a message field; proto3 optional keeps its type
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/reading.proto',
    proto_message := 'Reading',
    proto_extract := ['values', 'parts', 'counters', 'level', 'raw', 'main', 'main.count', 'kinds']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'payload');
----
values	VARCHAR
parts	VARCHAR
counters	VARCHAR
level	INTEGER
raw	BLOB
main	VARCHAR
main_count	BIGINT
kinds	VARCHAR

# imports resolve against the file's directory and protobuf's well-known types
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/event.proto',
    proto_message := 'Event',
    proto_extract := ['at', 'at.seconds', 'part.count', 'kind']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'payload');
----
at	VARCHAR
at_seconds	BIGINT
part_count	BIGINT
kind	VARCHAR

# proto_message is a name in the file's package or a full name: nested, imported and well-known types too
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto',
    proto_message := 'Outer.Inner', proto_extract := ['name']))
WHERE column_name = 'name';
----
name	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto',
    proto_message := 'fixture.nested.Outer', proto_extract := ['inner.name']))
WHERE column_name = 'inner_name';
----
inner_name	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'fixture.Event', proto_extract := ['kind']))
WHERE column_name = 'kind';
----
kind	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'Part', proto_extract := ['count']))
WHERE column_name = 'count';
----
count	BIGINT

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'google.protobuf.Timestamp', proto_extract := ['seconds']))
WHERE column_name = 'seconds';
----
seconds	BIGINT

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto', proto_message := 'Inner', proto_extract := ['name']);
----
Message type 'Inner' not found

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/reading.proto', proto_message := 'Reading',
    proto_extract := ['parts.name']);
----
Field 'parts' is repeated, cannot navigate to 'name'

statement error
SELECT * FROM nats_scan(NULL);
----
nats_scan: stream cannot be NULL

statement error
SELECT * FROM nats_scan('');
----
nats_scan: stream cannot be empty

statement error
SELECT * FROM nats_scan('s', subject := NULL);
----
nats_scan: subject cannot be NULL

statement error
SELECT * FROM nats_scan('s', start_seq := NULL);
----
nats_scan: start_seq cannot be NULL

statement error
SELECT * FROM nats_scan('s', end_time := NULL);
----
nats_scan: end_time cannot be NULL

statement error
SELECT * FROM nats_scan('s', json_extract := NULL);
----
nats_scan: json_extract cannot be NULL

statement error
SELECT * FROM nats_scan('s', json_extract := ['a', NULL]);
----
nats_scan: json_extract cannot contain NULL

statement error
SELECT * FROM nats_scan('s', proto_extract := ['']);
----
nats_scan: proto_extract cannot contain an empty field name

statement error
SELECT * FROM nats_scan('s', subject := 'a b');
----
nats_scan: invalid subject filter 'a b'

statement error
SELECT * FROM nats_scan('s', subject := 'a"b');
----
nats_scan: invalid subject filter

# end_seq alone is a sequence range, so it does not mix with a time range either
statement error
SELECT * FROM nats_scan('s', end_seq := 5, end_time := TIMESTAMP '2026-01-01 00:00:00');
----
Cannot mix sequence-based

statement ok
SET enable_external_access = false;

statement error
SELECT * FROM nats_scan('s');
----
Permission Error: nats_scan is disabled because enable_external_access is false
