# name: test/sql/nats_scan.test
# description: nats_scan checks that need no NATS server (the schema is resolved before connecting)
# group: [nats_js]

require nats_js

# base columns: the payload is a BLOB unless json_extract is used
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s'));
----
stream	VARCHAR
subject	VARCHAR
seq	UBIGINT
ts_nats	TIMESTAMP
headers	MAP(VARCHAR, VARCHAR[])
payload	BLOB

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', json_extract := ['device_id', 'kw']));
----
stream	VARCHAR
subject	VARCHAR
seq	UBIGINT
ts_nats	TIMESTAMP
headers	MAP(VARCHAR, VARCHAR[])
payload	VARCHAR
device_id	VARCHAR
kw	VARCHAR

# protobuf columns take their types from the schema
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/types_test.proto',
    proto_message := 'TypesTest',
    proto_extract := ['str_field', 'bytes_field', 'int32_field', 'int64_field', 'uint32_field', 'uint64_field',
                      'sint32_field', 'sint64_field', 'fixed32_field', 'fixed64_field', 'sfixed32_field',
                      'sfixed64_field', 'float_field', 'double_field', 'bool_field', 'status_field']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'headers');
----
payload	BLOB
str_field	VARCHAR
bytes_field	BLOB
int32_field	INTEGER
int64_field	BIGINT
uint32_field	UINTEGER
uint64_field	UBIGINT
sint32_field	INTEGER
sint64_field	BIGINT
fixed32_field	UINTEGER
fixed64_field	UBIGINT
sfixed32_field	INTEGER
sfixed64_field	BIGINT
float_field	FLOAT
double_field	DOUBLE
bool_field	BOOLEAN
status_field	VARCHAR

# nested fields use dot paths and become underscored columns; repeated fields are JSON arrays
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/telemetry.proto',
    proto_message := 'Telemetry',
    proto_extract := ['device_id', 'location.zone', 'metrics.kw', 'tags']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'headers', 'payload');
----
device_id	VARCHAR
location_zone	VARCHAR
metrics_kw	DOUBLE
tags	VARCHAR

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Telemetry',
    proto_extract := ['location.floor']);
----
Field 'floor' not found in message type 'Location'

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Telemetry',
    proto_extract := ['device_id.zone']);
----
Field 'device_id' is not a message type

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_message := 'Nope',
    proto_extract := ['device_id']);
----
Message type 'Nope' not found

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/missing.proto', proto_message := 'M', proto_extract := ['a']);
----
Failed to import protobuf schema file

statement error
SELECT * FROM nats_scan('s', proto_extract := ['a']);
----
proto_file parameter is required when using proto_extract

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/telemetry.proto', proto_extract := ['a']);
----
proto_message parameter is required when using proto_extract

statement error
SELECT * FROM nats_scan('s', json_extract := ['a'], proto_extract := ['b']);
----
Cannot use both json_extract and proto_extract parameters

statement error
SELECT * FROM nats_scan('s', unknown_option := 1);
----
unknown_option

# nothing listens on port 1
statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1');
----
Failed to connect to NATS

# json_extract paths become underscored columns; names that repeat a column get a suffix
query I
SELECT column_name FROM (DESCRIBE SELECT * FROM nats_scan('s', json_extract := ['location.zone', 'subject', 'Seq', 'kw', 'kw']));
----
stream
subject
seq
ts_nats
headers
payload
location_zone
subject_1
Seq_1
kw
kw_1

# repeated and map fields are JSON (VARCHAR), as is a message field; proto3 optional keeps its type
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/reading.proto',
    proto_message := 'Reading',
    proto_extract := ['values', 'parts', 'counters', 'level', 'raw', 'main', 'main.count', 'kinds']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'headers', 'payload');
----
values	VARCHAR
parts	VARCHAR
counters	VARCHAR
level	INTEGER
raw	BLOB
main	VARCHAR
main_count	BIGINT
kinds	VARCHAR

# imports resolve against the file's directory and protobuf's well-known types
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s',
    proto_file := 'test/proto/event.proto',
    proto_message := 'Event',
    proto_extract := ['at', 'at.seconds', 'part.count', 'kind']))
WHERE column_name NOT IN ('stream', 'subject', 'seq', 'ts_nats', 'headers', 'payload');
----
at	VARCHAR
at_seconds	BIGINT
part_count	BIGINT
kind	VARCHAR

# proto_message is a name in the file's package or a full name: nested, imported and well-known types too
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto',
    proto_message := 'Outer.Inner', proto_extract := ['name']))
WHERE column_name = 'name';
----
name	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto',
    proto_message := 'fixture.nested.Outer', proto_extract := ['inner.name']))
WHERE column_name = 'inner_name';
----
inner_name	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'fixture.Event', proto_extract := ['kind']))
WHERE column_name = 'kind';
----
kind	VARCHAR

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'Part', proto_extract := ['count']))
WHERE column_name = 'count';
----
count	BIGINT

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM nats_scan('s', proto_file := 'test/proto/event.proto',
    proto_message := 'google.protobuf.Timestamp', proto_extract := ['seconds']))
WHERE column_name = 'seconds';
----
seconds	BIGINT

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/nested.proto', proto_message := 'Inner', proto_extract := ['name']);
----
Message type 'Inner' not found

statement error
SELECT * FROM nats_scan('s', proto_file := 'test/proto/reading.proto', proto_message := 'Reading',
    proto_extract := ['parts.name']);
----
Field 'parts' is repeated, cannot navigate to 'name'

statement error
SELECT * FROM nats_scan(NULL);
----
nats_scan: stream cannot be NULL

statement error
SELECT * FROM nats_scan('');
----
nats_scan: stream cannot be empty

statement error
SELECT * FROM nats_scan('s', subject := NULL);
----
nats_scan: subject cannot be NULL

statement error
SELECT * FROM nats_scan('s', start_seq := NULL);
----
nats_scan: start_seq cannot be NULL

statement error
SELECT * FROM nats_scan('s', end_time := NULL);
----
nats_scan: end_time cannot be NULL

statement error
SELECT * FROM nats_scan('s', json_extract := NULL);
----
nats_scan: json_extract cannot be NULL

statement error
SELECT * FROM nats_scan('s', json_extract := ['a', NULL]);
----
nats_scan: json_extract cannot contain NULL

statement error
SELECT * FROM nats_scan('s', proto_extract := ['']);
----
nats_scan: proto_extract cannot contain an empty field name

statement error
SELECT * FROM nats_scan('s', subject := 'a b');
----
nats_scan: invalid subject filter 'a b'

statement error
SELECT * FROM nats_scan('s', subject := 'a"b');
----
nats_scan: invalid subject filter

statement error
SELECT * FROM nats_scan('s', subject := 'a' || chr(1));
----
nats_scan: invalid subject filter

# WHERE clauses on seq, ts_nats and subject narrow the range the scan reads, which EXPLAIN shows
query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE seq BETWEEN 3 AND 8;
----
physical_plan	<REGEX>:.*Sequences: from 3 to 8.*

query II
EXPLAIN SELECT * FROM nats_scan('s', start_seq := 5) WHERE seq > 2 AND 20 > seq;
----
physical_plan	<REGEX>:.*Sequences: from 5 to 19.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE seq = 7;
----
physical_plan	<REGEX>:.*Sequences: from 7 to 7.*

query II
EXPLAIN SELECT * FROM nats_scan('s', start_seq := 2, end_time := TIMESTAMP '2026-01-03')
WHERE ts_nats >= TIMESTAMP '2026-01-01' AND ts_nats < '2026-01-02';
----
physical_plan	<REGEX>:.*Sequences: from 2.*Times:.*from 2026-01-01 00:00:00 to 2026-01-01 23:59:59.999999.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject = 'orders.eu.failed';
----
physical_plan	<REGEX>:.*Subject: orders.eu.failed.*

# a prefix ending at a token boundary becomes a wildcard filter
query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject LIKE 'orders.eu.%';
----
physical_plan	<REGEX>:.*Subject: orders.eu.>.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject LIKE 'orders.e%';
----
physical_plan	<!REGEX>:.*Subject.*

# a subject with a wildcard or empty token, or one the server would not read, is left to DuckDB
query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject = 'orders.>.failed';
----
physical_plan	<!REGEX>:.*Subject.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject = 'orders.*';
----
physical_plan	<!REGEX>:.*Subject.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject LIKE 'orders.>.%';
----
physical_plan	<!REGEX>:.*Subject.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject LIKE 'orders..%';
----
physical_plan	<!REGEX>:.*Subject.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject = 'orders.eu' || chr(1);
----
physical_plan	<!REGEX>:.*Subject.*

query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE subject = repeat('a', 5000);
----
physical_plan	<!REGEX>:.*Subject.*

# the subject option is not replaced by a WHERE clause
query II
EXPLAIN SELECT * FROM nats_scan('s', subject := 'orders.>') WHERE subject = 'orders.eu.failed';
----
physical_plan	<REGEX>:.*Subject: orders.>.*

# filters that are not plain comparisons with a constant leave the range alone
query II
EXPLAIN SELECT * FROM nats_scan('s') WHERE seq > 3 OR seq < 2 OR subject = 'a.b';
----
physical_plan	<!REGEX>:.*(Sequences|Subject).*

# secrets of type nats: one way to sign in, plus TLS files; passwords and tokens are redacted
statement ok
CREATE SECRET prod (TYPE nats, USER 'alice', PASSWORD 's3cret', TLS_CA '/etc/nats/ca.pem', SCOPE 'tls://prod.example');

statement ok
CREATE SECRET dev (TYPE nats, TOKEN 't0ken');

query II
SELECT name, secret_string FROM duckdb_secrets() WHERE type = 'nats' ORDER BY name;
----
dev	name=dev;type=nats;provider=config;serializable=true;scope;token=redacted
prod	name=prod;type=nats;provider=config;serializable=true;scope=tls://prod.example;password=redacted;tls_ca=/etc/nats/ca.pem;user=alice

# a secret applies to URLs in its scope; one without a scope applies to every URL
query II
SELECT p.name, d.name FROM which_secret('tls://prod.example:4222', 'nats') p, which_secret('nats://localhost:4222', 'nats') d;
----
prod	dev

# nats_scan matches a scope only where a scheme, host or port ends (which_secret matches any start of the URL); the
# secrets' bad NKEY files show which one a scan uses
statement ok
CREATE SECRET port_4273 (TYPE nats, NKEY 'test/proto/event.proto', SCOPE 'nats://127.0.0.1:4273');

statement ok
CREATE SECRET host_local (TYPE nats, NKEY 'test/proto/event.proto', SCOPE 'nats://local');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:4273');
----
Cannot use NATS secret 'port_4273'

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:4273,nats://127.0.0.1:4274');
----
Cannot use NATS secret 'port_4273'

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:42733');
----
Failed to connect to NATS at 'nats://127.0.0.1:42733'

statement error
SELECT * FROM nats_scan('s', url := 'nats://localhost:42733');
----
Failed to connect to NATS at 'nats://localhost:42733'

statement ok
DROP SECRET port_4273;

statement ok
DROP SECRET host_local;

statement error
CREATE SECRET two (TYPE nats, TOKEN 't', CREDS '/etc/nats/user.creds');
----
A NATS secret takes one of USER and PASSWORD, TOKEN, CREDS or NKEY

statement error
CREATE SECRET half (TYPE nats, TLS_CERT '/etc/nats/client.pem');
----
A NATS secret takes TLS_CERT and TLS_KEY together

statement error
CREATE SECRET no_password (TYPE nats, USER 'alice');
----
A NATS secret takes USER and PASSWORD together

statement error
CREATE SECRET no_user (TYPE nats, PASSWORD 'pw');
----
A NATS secret takes USER and PASSWORD together

statement error
CREATE SECRET empty_token (TYPE nats, TOKEN '');
----
A NATS secret's TOKEN cannot be empty

statement error
SELECT * FROM nats_scan('s', secret := 'missing');
----
nats_scan: no NATS secret named 'missing'

statement ok
CREATE SECRET web (TYPE http, BEARER_TOKEN 'x');

statement error
SELECT * FROM nats_scan('s', secret := 'web');
----
nats_scan: no NATS secret named 'web'

# the secret's files are read when connecting
statement ok
CREATE SECRET broken (TYPE nats, TLS_CA 'test/proto/missing-ca.pem', SCOPE 'nats://127.0.0.1:1');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1');
----
Cannot use NATS secret 'broken'

statement ok
CREATE SECRET bad_nkey (TYPE nats, NKEY 'test/proto/event.proto');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1', secret := 'bad_nkey');
----
'test/proto/event.proto' does not hold a user NKey seed

# a credentials file must hold a user JWT, so that a seed file given as CREDS is not sent to the server
statement ok
CREATE SECRET seed_as_creds (TYPE nats, CREDS 'test/fixtures/auth/user.nk');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1', secret := 'seed_as_creds');
----
'test/fixtures/auth/user.nk' is not a NATS credentials file

# OpenSSL would ask for the passphrase of an encrypted key on the terminal
statement ok
CREATE SECRET encrypted_key (TYPE nats, TLS_CERT 'test/fixtures/auth/client.pem', TLS_KEY 'test/fixtures/auth/encrypted.key');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1', secret := 'encrypted_key');
----
'test/fixtures/auth/encrypted.key' is encrypted

# ~ is the home directory, as in DuckDB's file functions: the seed is read, and connecting fails
statement ok
SET home_directory = 'test/fixtures/auth';

statement ok
CREATE SECRET home_nkey (TYPE nats, NKEY '~/user.nk');

statement error
SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1', secret := 'home_nkey');
----
Failed to connect to NATS at 'nats://127.0.0.1:1'

statement ok
RESET home_directory;

# a statement prepared before external access was turned off is refused when executed
statement ok
PREPARE scan_before AS SELECT * FROM nats_scan('s', url := 'nats://127.0.0.1:1');

statement ok
SET enable_external_access = false;

statement error
EXECUTE scan_before;
----
nats_scan is disabled because enable_external_access is false

statement error
SELECT * FROM nats_scan('s');
----
Permission Error: nats_scan is disabled because enable_external_access is false
