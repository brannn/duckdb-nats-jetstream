# name: test/sql/integration/scan.test
# description: Reading streams from the test/fixtures/jetstream store (make test_integration)
# group: [nats_js]

require nats_js

require-env NATS_JS_TEST_URL

query IIIII
SELECT stream, subject, seq, ts_nats, octet_length(payload) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}');
----
events	events.site1.power	1	2026-10-21 23:05:28.745454	182
events	events.site10.power	2	2026-10-21 23:05:28.755481	55
events	events.site1.cooling	3	2026-10-21 23:05:28.765972	55
events	events.site1.power	4	2026-10-21 23:05:28.777294	8
events	events.site2.power	5	2026-10-21 23:05:28.787092	19
events	events.site2.power	6	2026-10-21 23:05:28.797891	4
events	events.site2.power	7	2026-10-21 23:05:28.808268	0
events	events.site1.power	8	2026-10-21 23:05:28.818733	54

# the payload is a BLOB, so binary data reads back unchanged
query I
SELECT payload FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', start_seq := 6, end_seq := 6);
----
\xFF\xFE\x00\x01

query I
SELECT count(*) FROM nats_scan('empty', url := '{NATS_JS_TEST_URL}');
----
0

# subject filters use NATS subject matching, not substrings
query I
SELECT list(seq) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', subject := 'events.site1.power');
----
[1, 4, 8]

query I
SELECT count(*) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', subject := 'events.site1');
----
0

query I
SELECT list(seq) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', subject := 'events.site1.*');
----
[1, 3, 4, 8]

query I
SELECT list(seq) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', subject := 'events.*.power');
----
[1, 2, 4, 5, 6, 7, 8]

query I
SELECT list(seq) FROM nats_scan('events', url := '{NATS_JS_TEST_URL}', subject := 'events.>');
----
[1, 2, 3, 4, 5, 6, 7, 8]

# sequence ranges are inclusive and skip deleted messages (gaps has 4-6 deleted)
query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}');
----
[1, 2, 3, 7, 8, 9, 10]

query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_seq := 3, end_seq := 8);
----
[3, 7, 8]

query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_seq := 4, end_seq := 6);
----
NULL

query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_seq := 9);
----
[9, 10]

query I
SELECT count(*) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_seq := 11);
----
0

# time ranges are inclusive at microsecond precision
query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}',
    start_time := TIMESTAMP '2026-10-21 23:05:29.085244', end_time := TIMESTAMP '2026-10-21 23:05:30.28116');
----
[2, 3, 7]

query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}',
    start_time := TIMESTAMP '2026-10-21 23:05:29.085245', end_time := TIMESTAMP '2026-10-21 23:05:30.281159');
----
[3]

# a start time inside the deleted range begins at the next stored message
query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_time := TIMESTAMP '2026-10-21 23:05:29.5');
----
[7, 8, 9, 10]

query I
SELECT count(*) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}',
    start_time := TIMESTAMP '2026-10-21 23:05:29.5', end_time := TIMESTAMP '2026-10-21 23:05:30');
----
0

query I
SELECT list(seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', end_time := TIMESTAMP '2026-10-21 23:05:28.847899');
----
[1]

query I
SELECT count(*) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', start_time := TIMESTAMP '2030-01-01');
----
0

query I
SELECT count(*) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}', end_time := TIMESTAMP '2020-01-01');
----
0

# filters on the result agree with the scan options
query I
SELECT list(seq ORDER BY seq) FROM nats_scan('gaps', url := '{NATS_JS_TEST_URL}')
WHERE ts_nats BETWEEN TIMESTAMP '2026-10-21 23:05:29.085244' AND TIMESTAMP '2026-10-21 23:05:30.28116';
----
[2, 3, 7]

# streams without allow_direct are read through the JetStream API
query III
SELECT seq, subject, decode(payload) FROM nats_scan('api_only', url := '{NATS_JS_TEST_URL}');
----
1	api.a	{"n":1}
3	api.a	{"n":3}
4	api.b	{"n":4}

query I
SELECT list(seq) FROM nats_scan('api_only', url := '{NATS_JS_TEST_URL}', subject := 'api.a', start_seq := 2);
----
[3]

query I
SELECT list(seq) FROM nats_scan('api_only', url := '{NATS_JS_TEST_URL}', start_time := TIMESTAMP '2000-01-01');
----
[1, 3, 4]

statement error
SELECT * FROM nats_scan('missing', url := '{NATS_JS_TEST_URL}');
----
Stream 'missing' not found
